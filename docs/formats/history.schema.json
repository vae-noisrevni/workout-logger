{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workout-logger.local/schemas/history.schema.json",
  "title": "Workout Logger — история тренировок",
  "type": "object",
  "required": ["workouts"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Версия формата. Необязательна при импорте."
    },
    "workouts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workout" }
    }
  },
  "$defs": {
    "workout": {
      "type": "object",
      "required": ["name", "date", "exercises"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "date": {
          "anyOf": [
            { "type": "string", "format": "date" },
            { "type": "string", "format": "date-time" }
          ],
          "description": "День тренировки: ГГГГ-ММ-ДД или полная ISO 8601 дата-время. Для сравнения с историей берётся календарный день в часовом поясе устройства."
        },
        "comment": { "type": "string", "default": "" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "description": "Порядок в массиве = порядок в тренировке.",
          "items": { "$ref": "#/$defs/workoutExercise" }
        }
      }
    },
    "workoutExercise": {
      "type": "object",
      "required": ["name", "sets"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Название упражнения. Оно должно уже быть в справочнике приложения (без учёта регистра), иначе импорт всего файла отклоняется."
        },
        "type": {
          "enum": ["weighted", "assisted", "bodyweight"],
          "description": "Только для информации; при импорте игнорируется."
        },
        "sets": {
          "type": "array",
          "minItems": 1,
          "description": "Порядок в массиве = порядок подходов.",
          "items": {
            "type": "object",
            "required": ["reps", "weight"],
            "additionalProperties": false,
            "properties": {
              "reps": { "type": "integer", "minimum": 1 },
              "weight": {
                "type": "number",
                "minimum": 0,
                "description": "Вес в кг; для bodyweight — 0, для assisted — величина помощи."
              }
            }
          }
        }
      }
    }
  }
}
